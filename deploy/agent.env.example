# /etc/agent/agent.env on the primary - chmod 600, owner root. Never commit the real file.
# Shared HMAC secret for heartbeats (same value on the watchdog host). Generate: openssl rand -hex 32
AGENT_WATCHDOG_SECRET=
# Optional: Slack/Discord-compatible incoming webhook that accepts {"text": "..."}
AGENT_ALERT_WEBHOOK=
# M7 paper trading needs NO exchange API keys: it reads public market data only.
